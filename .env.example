# PostgreSQL with pgvector is the default. Docker Compose publishes it on host port 55432.
# Port 5432 is left for a PostgreSQL install already running on Windows.
# Host tools use localhost:55432. The backend container uses hostname postgres and port 5432.
DATABASE_URL=postgresql+psycopg://helios:YOUR_PASSWORD@localhost:55432/helios
POSTGRES_USER=helios
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=helios
ENVIRONMENT=development

# Optional laptop mode, without Docker:
# DATABASE_URL=sqlite:///./data/helios.db

CHECKPOINT_PATH=./data/checkpoints.sqlite
# At least 32 characters. ENVIRONMENT=production rejects this placeholder and other known development values.
JWT_SECRET=replace-with-a-random-string-at-least-32-characters
ORG_CLOCK=2026-11-07
AUTO_SEED=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Chat completion. Leave the key empty to keep deterministic narration.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Embeddings are separate from the chat model.
# local uses the distilled static model minishlab/potion-retrieval-32M (512 dimensions).
# openai_compatible calls EMBEDDING_BASE_URL/embeddings and never the chat endpoint.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=minishlab/potion-retrieval-32M
EMBEDDING_DIMENSIONS=512
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_TIMEOUT_SECONDS=60

# Optional cross-encoder. Off by default. A failure is reported and does not change the claim that RRF ran.
RERANK_ENABLED=false
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
